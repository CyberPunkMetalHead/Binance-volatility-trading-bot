# ===========================================
# Binance Trading Bot - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ----- BINANCE API -----
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ----- TELEGRAM NOTIFICATIONS -----
# Create a bot: https://t.me/BotFather
# Get chat ID: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ENABLED=true

# ----- TRADING CONFIGURATION -----
TRADING_SYMBOL=BTCUSDT
TRADING_INTERVAL=1h
TRADE_AMOUNT_USDT=100

# ----- STRATEGY PARAMETERS (Optuna optimized) -----
# Best params for Sharpe 1.03, Annual Return 31.7%
FAST_PERIOD=76
SLOW_PERIOD=209
FILTER_PERIOD=23

# ----- RISK MANAGEMENT -----
TRAILING_STOP_PCT=0.0389
STOP_LOSS_PCT=0.0476
TAKE_PROFIT_PCT=0

# ----- MODE -----
# Set to false for live trading (use at your own risk!)
PAPER_TRADING=true
INITIAL_CAPITAL=10000

# ----- DATABASE (PostgreSQL) -----
# For Railway: DATABASE_URL is auto-set when you add PostgreSQL plugin
# For local/docker-compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_bot
# Or use separate variables:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=postgres
DB_PASSWORD=postgres
USE_DATABASE=true

# ----- LOGGING -----
LOG_LEVEL=INFO
